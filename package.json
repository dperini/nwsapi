{
  "name": "nwsapi",
  "version": "2.3.0-prerelease",
  "description": "Fast CSS Selectors API Engine",
  "keywords": [
    "css",
    "css3",
    "css4",
    "matcher",
    "selector"
  ],
  "homepage": "https://javascript.nwbox.com/nwsapi/",
  "bugs": {
    "url": "https://github.com/dperini/nwsapi/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Diego Perini",
    "email": "diego.perini@gmail.com",
    "web": "https://www.iport.it/"
  },
  "maintainers": [
    {
      "name": "Diego Perini",
      "email": "diego.perini@gmail.com",
      "web": "https://www.iport.it/"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/dperini/nwsapi.git"
  },
  "bin": {
    "nwsapi": "./dist/bin/nwsapi.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "main": "./dist/nwsapi",
  "scripts": {
    "bench": "pnpm run build && node scripts/repo/run.mts scripts/repo/bench/report.mts",
    "bench:accessors": "node scripts/repo/run.mts scripts/repo/bench/accessors.bench.mts",
    "bench:cache": "node scripts/repo/run.mts scripts/repo/bench/run.mts cache",
    "bench:memory": "node scripts/repo/run.mts scripts/repo/bench/run.mts memory",
    "bench:allocation-profile": "node scripts/repo/run.mts scripts/repo/bench/allocation-profile.mts",
    "bench:memory-browser-profile": "node scripts/repo/run.mts scripts/repo/bench/native-heap-snapshot.mts",
    "bench:memory-profile": "node scripts/repo/run.mts scripts/repo/bench/heap-snapshot.mts",
    "compare:memory": "pnpm run build && node scripts/repo/run.mts scripts/repo/bench/native-memory.mts",
    "compare:memory:jsdom": "pnpm run build && node scripts/repo/run.mts scripts/repo/bench/footprint.mts",
    "report:build": "pnpm run build && node scripts/repo/run.mts scripts/repo/bench/build-compression.mts",
    "report:size": "pnpm run build && node scripts/repo/run.mts scripts/repo/bench/filesize.mts",
    "gen:bench": "node scripts/repo/run.mts scripts/repo/gen/benchmark-charts.mts && node scripts/repo/run.mts scripts/repo/gen/readme-performance.mts && node scripts/repo/run.mts scripts/repo/gen/footprint-charts.mts",
    "bench:jsdom": "pnpm run build && node scripts/repo/run.mts scripts/repo/bench/jsdom-override.mts",
    "bench:selectors": "node scripts/repo/run.mts scripts/repo/bench/run.mts selectors",
    "check:svg": "node scripts/repo/run.mts scripts/repo/check/svgs-are-optimized.mts",
    "check:unicode-es5": "node scripts/repo/run.mts scripts/repo/check/unicode-es5.mts",
    "check:wpt-candidates": "node scripts/repo/run.mts scripts/repo/check/wpt/candidates.mts",
    "check:wpt-inventory": "node scripts/repo/run.mts scripts/repo/check/wpt/inventory.mts",
    "check:wpt-scope": "node scripts/repo/run.mts scripts/repo/check/wpt/scope.mts",
    "fix:svg": "node scripts/repo/run.mts scripts/repo/check/svgs-are-optimized.mts --fix",
    "gen:memory": "node scripts/repo/run.mts scripts/repo/gen/memory-performance.mts",
    "check:memory": "node scripts/repo/run.mts scripts/repo/gen/memory-performance.mts --check",
    "gen:api": "node scripts/repo/run.mts scripts/repo/gen/api-md.mts",
    "check:api": "node scripts/repo/run.mts scripts/repo/gen/api-md.mts --check",
    "check": "node scripts/repo/run.mts scripts/repo/check.mts",
    "fix": "node scripts/repo/run.mts scripts/repo/fix.mts",
    "update:chrome": "node scripts/repo/run.mts scripts/repo/update/chrome.mts",
    "update": "node scripts/repo/run.mts scripts/repo/update.mts",
    "soak:check": "node scripts/repo/run.mts scripts/repo/soak.mts --check",
    "soak:bypass": "node scripts/repo/run.mts scripts/repo/soak.mts --bypass",
    "setup:browser": "node scripts/repo/run.mts scripts/repo/browser.mts",
    "prepare": "node scripts/repo/run.mts scripts/repo/setup.mts",
    "ci:local": "node scripts/repo/run.mts node_modules/run-local-ci/dist/native-launcher.js run --workflow .github/workflows/node.js.yml --quiet --pause-on-failure --github-token",
    "clean": "node scripts/repo/run.mts scripts/repo/clean.mts",
    "lint": "node scripts/repo/run.mts scripts/repo/lint.mts",
    "format": "node scripts/repo/run.mts scripts/repo/format.mts",
    "format:check": "node scripts/repo/run.mts scripts/repo/format.mts --check",
    "build": "node scripts/repo/run.mts scripts/repo/build/run.mts",
    "prepack": "node scripts/repo/build/require-staging.mts",
    "serve": "node scripts/repo/run.mts scripts/repo/serve.mts",
    "test": "node scripts/repo/run.mts scripts/repo/test.mts unit",
    "test:fuzz": "pnpm run build && node scripts/repo/run.mts scripts/repo/fuzz.mts",
    "test:fuzz:replay": "pnpm run build && node scripts/repo/run.mts scripts/repo/fuzz.mts --replay",
    "cover:types": "node scripts/repo/run.mts scripts/repo/cover/types/run.mts",
    "type": "node scripts/repo/run.mts node_modules/typescript/bin/tsc --noEmit -p .config/tsconfig.check.json",
    "test:node": "node scripts/repo/run.mts scripts/repo/test.mts all",
    "test:legacy": "node scripts/repo/run.mts node_modules/vitest/vitest.mjs run --config .config/vitest.config.mts test/repo/unit/legacy-dom.test.mts",
    "test:unit": "node scripts/repo/run.mts scripts/repo/test.mts unit",
    "test:integration": "node scripts/repo/run.mts scripts/repo/test.mts integration",
    "test:e2e": "pnpm run test:browser && pnpm run test:package && pnpm run test:wpt",
    "test:watch": "node scripts/repo/run.mts node_modules/vitest/vitest.mjs --watch --config .config/vitest.config.mts",
    "cover": "node scripts/repo/run.mts scripts/repo/cover.mts",
    "gen:coverage": "node scripts/repo/run.mts scripts/repo/gen/coverage-badge.mts",
    "check:coverage": "node scripts/repo/run.mts scripts/repo/gen/coverage-badge.mts --check",
    "test:package": "pnpm run build && node scripts/repo/run.mts test/repo/e2e/jsdom-adapter-package.mts",
    "test:wpt:native": "node scripts/repo/run.mts scripts/repo/check/wpt/native-run.mts",
    "test:wpt:native:status": "node scripts/repo/run.mts scripts/repo/check/wpt/native-status.mts",
    "check:wpt-native-contract": "node scripts/repo/run.mts scripts/repo/check/wpt/native-contract.mts --check",
    "check:wpt-native-pool": "node scripts/repo/run.mts scripts/repo/check/wpt/native-pool.mts",
    "check:wpt-native-scope": "node scripts/repo/run.mts scripts/repo/check/wpt/native-scope.mts",
    "test:wpt": "pnpm run build && node scripts/repo/run.mts scripts/repo/test.mts upstream",
    "upstream:clone": "node scripts/repo/run.mts scripts/repo/git-partial-submodule.mts clone",
    "upstream:verify": "node scripts/repo/run.mts scripts/repo/git-partial-submodule.mts verify && pnpm run check:wpt-candidates",
    "test:attributes": "node scripts/repo/run.mts node_modules/vitest/vitest.mjs run --config .config/vitest.config.mts test/repo/unit/attribute-parse-error.test.mts",
    "test:attributes:browser": "NWSAPI_BROWSER=1 node scripts/repo/run.mts node_modules/vitest/vitest.mjs run --config .config/vitest.config.mts test/repo/e2e/attribute-strings-browser.test.mts",
    "test:browser": "NWSAPI_BROWSER=1 node scripts/repo/run.mts node_modules/vitest/vitest.mjs run --config .config/vitest.config.mts test/repo/e2e && pnpm run test:media",
    "test:media": "node scripts/repo/run.mts scripts/repo/build/run.mts && node scripts/repo/run.mts node_modules/@playwright/test/cli.js test --config .config/state-pseudos.config.mts",
    "test:optimizer": "node scripts/repo/run.mts node_modules/vitest/vitest.mjs run --config .config/vitest.config.mts test/repo/unit/optimizer-nesting.test.mts",
    "compile": "node dist/bin/nwsapi.js compile",
    "bench:profile": "node scripts/repo/run.mts scripts/repo/bench/profile.mts",
    "package": "pnpm run build && node scripts/repo/run.mts scripts/repo/build/package.mts"
  },
  "devDependencies": {
    "@asamuzakjp/dom-selector": "catalog:",
    "@playwright/test": "catalog:",
    "@puppeteer/browsers": "catalog:",
    "@swc/core": "catalog:",
    "@types/css-tree": "catalog:",
    "@types/istanbul-lib-coverage": "catalog:",
    "@types/istanbul-lib-report": "catalog:",
    "@types/istanbul-reports": "catalog:",
    "@types/jsdom": "catalog:",
    "@types/node": "catalog:",
    "@ultrathink/acorn.rs.wasm": "catalog:",
    "@unicode/unicode-17.0.0": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitiate/core": "catalog:",
    "acorn": "catalog:",
    "ast-v8-to-istanbul": "catalog:",
    "eslint-plugin-compat": "catalog:",
    "istanbul-lib-coverage": "catalog:",
    "istanbul-lib-report": "catalog:",
    "istanbul-reports": "catalog:",
    "jquery": "catalog:",
    "jsdom": "catalog:",
    "mitata": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "parse5": "catalog:",
    "rolldown": "catalog:",
    "run-local-ci": "catalog:",
    "svgo": "catalog:",
    "taze": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  },
  "peerDependencies": {
    "css-tree": "^3.2.1",
    "jsdom": "^30.0.1"
  },
  "peerDependenciesMeta": {
    "css-tree": {
      "optional": true
    },
    "jsdom": {
      "optional": true
    }
  },
  "browserslist": [
    "ie 11"
  ],
  "devEngines": {
    "packageManager": [
      {
        "name": "pnpm",
        "version": "^11.25.0 || >=12.3.4",
        "onFail": "error"
      }
    ]
  },
  "allowScripts": {
    "fsevents": false
  },
  "licenses": [
    {
      "type": "MIT",
      "url": "https://javascript.nwbox.com/nwsapi/MIT-LICENSE"
    }
  ]
}
