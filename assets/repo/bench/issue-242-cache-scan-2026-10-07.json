  "reproducerSource": "import { createRequire } from 'node:module'\nimport { writeFileSync } from 'node:fs'\nimport { execFileSync } from 'node:child_process'\nimport { JSDOM } from 'jsdom'\nconst require = createRequire(import.meta.url)\nconst master = require('./master.cjs')\nconst v3 = require('../../dist/nwsapi.js')\nconst root = process.cwd()\nconst cases = [\n  ...[1000, 1001, 2300, 4096, 4097, 5000].map(count => ({ shape: 'class', count })),\n  ...[1000, 1001, 1254, 2300, 4097].map(count => ({ shape: 'antd-like', count })),\n]\nconst results = []\nfor (const [branch, factory] of [['master', master], ['prerelease/3.0.0', v3]]) {\n  for (const { shape, count } of cases) {\n    const { window } = new JSDOM('<!doctype html><p class=\"c0\">')\n    const element = window.document.querySelector('p')\n    const engine = factory({ document: window.document, DOMException: window.DOMException })\n    const selectors = Array.from({ length: count }, (_, i) => shape === 'class' ? `.c${i}` : `:where(.css-x).ant-btn-${i}:not(:disabled):not(.ant-btn-disabled):hover`)\n    selectors.forEach(selector => engine.match(selector, element))\n    const cache = engine.matchResolvers\n    const get = cache.get.bind(cache)\n    let found = false\n    cache.get = key => {\n      const value = get(key)\n      found ||= value !== undefined\n      return value\n    }\n    let compiles = 0\n    const setLambda = engine.matchLambdas.set.bind(engine.matchLambdas)\n    engine.matchLambdas.set = (...args) => {\n      compiles++\n      return setLambda(...args)\n    }\n    const missesByPass = []\n    for (let pass = 0; pass < 10; pass++) {\n      let misses = 0\n      for (const selector of selectors) {\n        found = false\n        engine.match(selector, element)\n        misses += !found\n      }\n      missesByPass.push(misses)\n    }\n    const misses = missesByPass.reduce((total, value) => total + value, 0)\n    const row = { branch, shape, selectors: count, matches: count * 10, misses, hitRate: (count * 10 - misses) / (count * 10), missesByPass, lambdaInsertions: compiles, retained: cache.size(), retainedBytes: cache.bytes?.() }\n    results.push(row)\n    console.log(JSON.stringify(row))\n    window.close()\n  }\n}\nconst git = ref => execFileSync('git', ['rev-parse', ref], { cwd: root, encoding: 'utf8' }).trim()\nwriteFileSync('.cache/issue-242/results.json', JSON.stringify({ issue: 'https://github.com/dperini/nwsapi/issues/242', node: process.version, jsdom: require('jsdom/package.json').version, revisions: { master: git('origin/master'), v3: git('origin/prerelease/3.0.0') }, passes: 10, results }, null, 2) + '\\n')\n"
