  "method": {
    "warmup": "One complete scan in selector order before counting.",
    "measurement": "Ten complete scans in the same order against one paragraph element.",
    "cacheMisses": "Wrap matchResolvers.get and observe actual lookups during match, without making extra cache reads.",
