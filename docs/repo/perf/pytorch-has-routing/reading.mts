/// <reference types="vite/client" />
import { Marked } from 'marked'
import { element } from './ui.mts'
import { readingMarkup } from './markdown.mts'
import { initializeHighlighting } from './highlight.mts'
import { initializeLinkMarkers } from './links.mts'
import { currentLocale, initializeLocale, translate } from './locale.mts'
import { localizeText } from './locale-content.mts'
import { setHeaderContext } from './header-context.mts'
import { reportMarkup } from './reading-report.mts'
import { initializeReadingPrint } from './reading-print.mts'
import { followReading } from './reading-progress.mts'
import {
  documentHref,
  documentLoaders,
  getDocument,
  loadDocument,
} from './documents.mts'
import {
  initializeReadingContents,
  renderRelatedDocuments,
} from './reading-navigation.mts'
import { showLoadingAfterDelay } from './reading-loading.mts'
import {
  beginReaderRetry,
  focusReaderRetryResult,
  readerRetryOwnsFocus,
} from './reading-retry.mts'

let documentPath = 'docs/repo/perf/pytorch-for-beginners.md'
let sourceBase = new URL('https://guide.invalid/' + documentPath)
let renderRequest = 0
let cancelLoadingIndicator: (() => void) | undefined
let retryControlForFocus: HTMLButtonElement | undefined
let retryRequestForRender = false
let stopFollowing: (() => void) | undefined
let stopWatchingTables: (() => void) | undefined
let originalHeadings: string[] = []
const reports = import.meta.glob<string>(
  [
    '../../../../assets/repo/bench/survey-2026-10-03/neural-dispatch-crossed-2026-10-05.html',
    '../../../../assets/repo/bench/survey-2026-10-03/neural-dispatch-jit-2026-10-05.html',
  ],
  { query: '?url', import: 'default', eager: true },
)
const repositorySvgAssets = import.meta.glob<string>(
  '../../../../assets/repo/**/*.svg',
  {
    query: '?url',
    import: 'default',
    eager: true,
  },
)
const repositorySvgHrefs = new Map(
  Object.entries(repositorySvgAssets).map(([path, emitted]) => [
    new URL(path, 'https://guide.invalid/docs/repo/perf/pytorch-has-routing/')
      .pathname,
    emitted,
  ]),
)
const repository = 'https://github.com/dperini/nwsapi'
const revision = 'prerelease/3.0.0'
const markdown = new Marked({ gfm: true })

export function reportHref(url: URL) {
  const name = url.pathname.split('/').pop()
  const entry = Object.entries(reports).find(
    ([path, emitted]) =>
      path.endsWith(`/${name}`) || emitted.endsWith(`/${name}`),
  )
  return entry
    ? documentHref(
        new URL(
          entry[0],
          'https://guide.invalid/docs/repo/perf/pytorch-has-routing/',
        ).pathname.slice(1),
      ) + url.hash
    : undefined
}

export function documentMarkup(source: string, locale: 'en' | 'it') {
  const markup = documentPath.endsWith('.html')
    ? reportMarkup(source, locale)
    : readingMarkup(markdown.parse(source, { async: false }))
  if (documentPath !== 'docs/repo/selector/api.md') {
    return markup
  }
  const template = document.createElement('template')
  template.innerHTML = markup
  for (const notice of template.content.querySelectorAll('blockquote')) {
    if (
      [
        'Generated by pnpm run gen:api. Do not edit this file by hand.',
        'Generato da pnpm run gen:api. Non modificare questo file a mano.',
      ].includes(notice.textContent?.trim() ?? '')
    ) {
      notice.remove()
    }
  }
  return template.innerHTML
}

export function contentsSelector() {
  return documentPath.endsWith('.html') ? 'h2' : 'h2, h3'
}

export function resolveLink(href: string): string | undefined {
  const url = new URL(href, sourceBase)
  if (!['https:', 'http:', 'mailto:'].includes(url.protocol)) {
    return undefined
  }
  if (href.startsWith('#')) {
    return href
  }
  if (url.hostname.endsWith('.localhost') || url.origin === sourceBase.origin) {
    const report = reportHref(url)
    if (report) {
      return report
    }
  }
  if (url.origin !== sourceBase.origin) {
    return href
  }
  const name = url.pathname.split('/').pop() ?? ''
  if (getDocument(url.pathname.slice(1))) {
    return documentHref(url.pathname.slice(1)) + url.hash
  }
  if (name === 'pytorch-has-routing.html') {
    return './pytorch-has-routing.html' + url.hash
  }
  const view = url.pathname.endsWith('/') ? 'tree' : 'blob'
  return `${repository}/${view}/${revision}${url.pathname}${url.hash}`
}

export function prepareLinks(article: ParentNode) {
  for (const link of article.querySelectorAll<HTMLAnchorElement>('a[href]')) {
    const href = resolveLink(link.getAttribute('href')!)
    if (href) {
      link.setAttribute('href', href)
    } else {
      link.removeAttribute('href')
    }
  }
  for (const image of article.querySelectorAll<HTMLImageElement>('img[src]')) {
    const url = new URL(image.getAttribute('src')!, sourceBase)
    if (url.origin === sourceBase.origin) {
      const emitted = repositorySvgHrefs.get(url.pathname)
      image.src = emitted
        ? `${emitted}${url.search}${url.hash}`
        : `https://raw.githubusercontent.com/dperini/nwsapi/refs/heads/${revision}${url.pathname}${url.search}${url.hash}`
    }
    image.loading = 'lazy'
  }
}

export function prepareTables(article: HTMLElement) {
  stopWatchingTables?.()
  const wrappers: HTMLElement[] = []
  const observer = new ResizeObserver(entries => {
    for (const entry of entries) {
      const wrapper = entry.target.closest<HTMLElement>('.table-scroll')
      if (wrapper) {
        updateTableRegion(wrapper)
      }
    }
  })
  for (const table of article.querySelectorAll('table')) {
    const wrapper = document.createElement('div')
    wrapper.className = 'table-scroll'
    const heading = nearestTableHeading(article, table)
    const caption = table.caption ?? table.createCaption()
    if (!caption.textContent?.trim()) {
      caption.className = 'reading-table-caption'
      caption.textContent = tableCaption(heading, article, table)
    }
    for (const header of table.querySelectorAll<HTMLTableCellElement>(
      'thead th',
    )) {
      if (!header.hasAttribute('scope')) {
        header.scope = 'col'
      }
    }
    for (const header of table.querySelectorAll<HTMLTableCellElement>(
      'tbody th',
    )) {
      if (!header.hasAttribute('scope')) {
        header.scope = 'row'
      }
    }
    table.before(wrapper)
    wrapper.append(table)
    wrappers.push(wrapper)
    updateTableRegion(wrapper)
    observer.observe(wrapper)
    observer.observe(table)
  }
  const updateAll = () => {
    wrappers.forEach(updateTableRegion)
  }
  window.addEventListener('resize', updateAll)
  stopWatchingTables = () => {
    observer.disconnect()
    window.removeEventListener('resize', updateAll)
  }
}

function nearestTableHeading(article: HTMLElement, table: HTMLTableElement) {
  let current: HTMLElement | undefined
  for (const heading of article.querySelectorAll<HTMLElement>(
    'h1, h2, h3, h4, h5, h6',
  )) {
    if (
      heading.compareDocumentPosition(table) & Node.DOCUMENT_POSITION_FOLLOWING
    ) {
      current = heading
    }
  }
  return current
}

function tableCaption(
  heading: HTMLElement | undefined,
  article: HTMLElement,
  table: HTMLTableElement,
) {
  const title = heading?.textContent?.trim() || translate('comparisonTable')
  const previousTables = Array.from(article.querySelectorAll('table')).filter(
    candidate =>
      candidate !== table &&
      (candidate.compareDocumentPosition(table) &
        Node.DOCUMENT_POSITION_FOLLOWING) !==
        0 &&
      (nearestTableHeading(article, candidate)?.textContent?.trim() ||
        translate('comparisonTable')) === title,
  )
  return previousTables.length
    ? `${title} (${previousTables.length + 1})`
    : title
}

function updateTableRegion(wrapper: HTMLElement) {
  const overflowing = wrapper.scrollWidth > wrapper.clientWidth + 1
  if (overflowing) {
    wrapper.tabIndex = 0
    wrapper.setAttribute('role', 'region')
    wrapper.setAttribute(
      'aria-label',
      `${wrapper.querySelector('caption')?.textContent?.trim() ?? ''}: ${translate('comparisonTable')}`,
    )
  } else {
    wrapper.tabIndex = -1
    wrapper.removeAttribute('role')
    wrapper.removeAttribute('aria-label')
  }
}

export function createContents(article: HTMLElement) {
  const contents = element('reading-contents')
  contents.replaceChildren()
  contents.dataset['localeContent'] = ''
  const used = new Map<string, number>()
  const headings = Array.from(
    article.querySelectorAll<HTMLElement>(contentsSelector()),
  )
  for (const [index, heading] of headings.entries()) {
    const title = heading.textContent ?? ''
    heading.tabIndex = -1
    const base =
      (originalHeadings[index] ?? title)
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-|-$/g, '') || 'section'
    const count = used.get(base) ?? 0
    used.set(base, count + 1)
    heading.id = count ? `${base}-${count}` : base
    const item = document.createElement('li')
    item.dataset['depth'] = heading.tagName.slice(1)
    const link = document.createElement('a')
    link.href = `#${heading.id}`
    link.textContent = title
    item.append(link)
    contents.append(item)
  }
  return headings
}

function focusReadingTarget(id: string, scroll = true) {
  if (!id) {
    return
  }
  const target = document.getElementById(id)
  if (!target) {
    return
  }
  const navigation = element('reading-navigation') as HTMLDetailsElement
  if (
    target.closest('#reading-content') &&
    matchMedia('(max-width: 600px)').matches
  ) {
    const toggle = document.querySelector<HTMLButtonElement>(
      '[data-reader-contents-toggle]',
    )
    if (navigation.open && toggle && !toggle.disabled) {
      toggle.click()
    } else {
      navigation.open = false
    }
  }
  let disclosure = target.closest('details')
  while (disclosure) {
    disclosure.open = true
    disclosure = disclosure.parentElement?.closest('details') ?? null
  }
  target.focus({ preventScroll: true })
  if (scroll) {
    target.scrollIntoView({ block: 'start', behavior: 'instant' })
  }
}

export function renderDocument(source: string) {
  const article = element('reading-content')
  const focusHeading = readerRetryOwnsFocus(article, retryControlForFocus)
  retryControlForFocus = undefined
  const wasRetryRequest = retryRequestForRender
  retryRequestForRender = false
  cancelLoadingIndicator?.()
  cancelLoadingIndicator = undefined
  const label = getDocument(documentPath)?.title
  const translationNotice = element('reading-translation-notice')
  translationNotice.hidden =
    currentLocale() !== 'it' ||
    documentPath !== 'docs/repo/perf/pytorch-for-beginners.md'
  // Only bundled repository documents enter the renderer, never URL-provided text.
  article.dataset['localeContent'] = ''
  article.classList.toggle('reading-report', documentPath.endsWith('.html'))
  const rendered = document.createElement('template')
  rendered.innerHTML = documentMarkup(source, currentLocale())
  prepareLinks(rendered.content)
  article.replaceChildren(rendered.content)
  article.removeAttribute('aria-busy')
  const title =
    article.querySelector('h1')?.textContent?.trim() ??
    label ??
    translate('furtherReading')
  document.title = `${title} · ${localizeText('NWSAPI model guide', currentLocale())}`
  setHeaderContext(title)
  const minutes = Math.max(
    1,
    Math.ceil((article.textContent ?? '').split(/\s+/).length / 220),
  )
  const heading = article.querySelector('h1')
  if (heading) {
    const titleRow = document.createElement('div')
    titleRow.className = 'reading-title-row'
    heading.before(titleRow)
    titleRow.append(heading)
    const readingTime = document.createElement('span')
    readingTime.id = 'reading-time'
    readingTime.textContent = translate('readMinutes').replace(
      '{minutes}',
      new Intl.NumberFormat(currentLocale()).format(minutes),
    )
    titleRow.append(readingTime)
  }
  const sourceLink = element('reading-source-link') as HTMLAnchorElement
  sourceLink.href = `${repository}/blob/${revision}/${documentPath}`
  sourceLink.hidden = false
  initializeLinkMarkers()
  prepareTables(article)
  const headings = createContents(article)
  stopFollowing?.()
  stopFollowing = followReading(headings, documentPath)
  initializeHighlighting()
  renderRelatedDocuments(documentPath)
  const titleHeading = article.querySelector<HTMLElement>('h1')
  if (focusHeading && titleHeading) {
    focusReaderRetryResult(true, titleHeading, true)
  } else if (!wasRetryRequest) {
    requestAnimationFrame(() => {
      focusReadingTarget(decodeURIComponent(location.hash.slice(1)))
    })
  }
}

export async function openDocument(retry = false) {
  const request = ++renderRequest
  retryRequestForRender = retry
  cancelLoadingIndicator?.()
  cancelLoadingIndicator = undefined
  element('reading-source-link').hidden = true
  const slug =
    new URLSearchParams(location.search).get('doc') ?? 'pytorch-for-beginners'
  documentPath = resolveDocumentPath(slug)
  sourceBase = new URL('https://guide.invalid/' + documentPath)
  if (!Object.hasOwn(documentLoaders, documentPath)) {
    retryControlForFocus = undefined
    retryRequestForRender = false
    const article = element('reading-content')
    article.removeAttribute('data-loading-visible')
    article.removeAttribute('aria-busy')
    article.innerHTML = `<h1>${translate('documentNotFound')}</h1><p>${translate('documentNotFoundHelp')}</p>`
    element('reading-navigation').hidden = true
    document.title = translate('documentNotFound')
    setHeaderContext(translate('documentNotFound'))
    return
  }
  const article = element('reading-content')
  if (article.getAttribute('aria-busy') === 'true') {
    cancelLoadingIndicator = showLoadingAfterDelay(
      article,
      () => request === renderRequest,
    )
  }
  let source: string | undefined
  try {
    source = await loadDocument(documentPath, { retry })
  } catch {
    if (request === renderRequest) {
      showDocumentLoadError()
    }
    return
  }
  if (source === undefined) {
    if (request === renderRequest) {
      showDocumentLoadError()
    }
    return
  }
  const headings = document.createElement('template')
  headings.innerHTML = documentMarkup(source, 'en')
  prepareLinks(headings.content)
  originalHeadings = Array.from(
    headings.content.querySelectorAll(contentsSelector()),
    node => node.textContent ?? '',
  )
  let translated = source
  if (
    currentLocale() === 'it' &&
    documentPath !== 'docs/repo/perf/pytorch-for-beginners.md'
  ) {
    try {
      const catalog = (
        await import('../../../../assets/repo/model-guide/locales/documents.it.generated.json')
      ).default as Record<string, { text: string }>
      translated = catalog[documentPath]?.text ?? source
    } catch {
      if (request === renderRequest) {
        showDocumentLoadError()
      }
      return
    }
  }
  if (request === renderRequest) {
    renderDocument(translated)
  }
}

function showDocumentLoadError() {
  const article = element('reading-content')
  const focusRetry = readerRetryOwnsFocus(article, retryControlForFocus)
  retryControlForFocus = undefined
  retryRequestForRender = false
  cancelLoadingIndicator?.()
  cancelLoadingIndicator = undefined
  article.removeAttribute('aria-busy')
  const title = translate('documentLoadFailed')
  const heading = document.createElement('h1')
  heading.textContent = title
  const retry = document.createElement('button')
  retry.type = 'button'
  retry.dataset['readerRetry'] = ''
  retry.textContent = translate('retryDocument')
  retry.addEventListener('click', () => {
    if (!beginReaderRetry(retry, translate('readingLoading'))) {
      return
    }
    retryControlForFocus = readerRetryOwnsFocus(article, retry)
      ? retry
      : undefined
    retryRequestForRender = true
    article.setAttribute('aria-busy', 'true')
    void openDocument(true)
  })
  const catalog = document.createElement('a')
  catalog.href = './index.html'
  catalog.textContent = translate('browseDocuments')
  const actions = document.createElement('p')
  actions.className = 'reading-recovery'
  actions.append(retry, catalog)
  article.replaceChildren(heading, actions)
  focusReaderRetryResult(focusRetry, retry)
  document.title = `${title} · ${localizeText('NWSAPI model guide', currentLocale())}`
  setHeaderContext(title)
  element('reading-navigation').hidden = true
}

function resolveDocumentPath(value: string) {
  if (getDocument(value)) {
    return value
  }
  const legacyPath = `docs/repo/perf/${value}.md`
  if (getDocument(legacyPath)) {
    return legacyPath
  }
  return value
}

initializeLocale()
initializeReadingContents()
initializeReadingPrint()
window.addEventListener('guide-locale-change', () => {
  void openDocument()
})
void openDocument()
