import type { EngineState } from './engine.d.ts'
import type { EngineGlobal } from './types.mts'

type InitialState = { [Key in keyof EngineState]: EngineState[Key] | undefined }

type StateConstructor = new (
  global: EngineGlobal,
  Factory: EngineState['Factory'],
) => EngineState

export function createState(
  global: EngineGlobal,
  Factory: EngineState['Factory'],
): EngineState {
  return new (initializeState as unknown as StateConstructor)(global, Factory)
}

