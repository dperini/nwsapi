import { mkdtempSync, readFileSync, rmSync } from 'node:fs'
import os from 'node:os'
import path from 'node:path'
import { afterEach, expect, test } from 'vitest'
import {
  configureEditor,
  describeEditorSetup,
  editorFiles,
  editorSetupPlan,
  jsonFile,
  writeGeneratedFile,
} from '../../../../scripts/repo/setup/editor.mts'

const roots: string[] = []

afterEach(() => {
  for (const root of roots.splice(0)) {
    rmSync(root, { recursive: true, force: true })
  }
})

function temporaryRoot() {
  const root = mkdtempSync(path.join(os.tmpdir(), 'nwsapi-editor-'))
  roots.push(root)
  return root
}

test('editor setup selects tsrs where its pinned binary is published', () => {
  const mac = editorFiles('darwin', 'arm64')
  const linux = editorFiles('linux', 'x64')
  expect(mac.engine).toBe('tsrs')
  expect(linux.engine).toBe('tsrs')
  expect(editorFiles('darwin', 'x64').engine).toBe('tsgo')
  expect(editorFiles('win32', 'x64').engine).toBe('tsgo')
})

test('editor setup writes repeatable workspace settings and launchers', () => {
  const root = temporaryRoot()
  const result = configureEditor(root, 'darwin', 'arm64')
  expect(result.engine).toBe('tsrs')
  expect(result.results.every(item => item.status === 'written')).toBe(true)
  expect(
    configureEditor(root, 'darwin', 'arm64').results.every(
      item => item.status === 'current',
    ),
  ).toBe(true)
  expect(readFileSync(path.join(root, '.zed/settings.json'), 'utf8')).toContain(
    '.cache/editor/tsdk/tsrs',
  )
  expect(
    readFileSync(path.join(root, '.vscode/settings.json'), 'utf8'),
  ).toContain('js/ts.experimental.useTsgo')
})

test('editor setup preserves existing custom settings', () => {
  const root = temporaryRoot()
  writeGeneratedFile(root, '.vscode/settings.json', '{\n  "custom": true\n}\n')
  const result = configureEditor(root, 'darwin', 'arm64')
  expect(
    result.results.find(item => item.path === '.vscode/settings.json')?.status,
  ).toBe('preserved')
  expect(
    readFileSync(path.join(root, '.vscode/settings.json'), 'utf8'),
  ).toContain('"custom": true')
  expect(result.messages.join('\n')).toContain('were preserved')
})

test('Windows editor setup uses pinned native preview in both editors', () => {
  const root = temporaryRoot()
  const files = editorFiles('win32', 'x64')
  const result = configureEditor(root, 'win32', 'x64')
  expect(result.engine).toBe('tsgo')
  expect(files.launchers).toEqual([])
  expect(
    readFileSync(path.join(root, '.vscode/settings.json'), 'utf8'),
  ).toContain('node_modules/@typescript/native-preview')
  expect(readFileSync(path.join(root, '.zed/settings.json'), 'utf8')).toContain(
    'native-preview-win32-x64/lib/tsgo.exe',
  )
})

test('editor setup exposes dry-run and command descriptions', () => {
  expect(editorSetupPlan('/checkout', 'linux', 'arm64')).toMatchObject({
    type: 'preview',
    engine: 'tsrs',
    targets: expect.arrayContaining([
      '/checkout/.vscode/settings.json',
      '/checkout/.zed/settings.json',
    ]),
  })
  expect(describeEditorSetup()).toMatchObject({
    name: 'setup/editor',
    options: expect.arrayContaining(['--json', '--describe', '--dry-run']),
  })
})

test('generated editor settings are marked and formatted JSON', () => {
  expect(jsonFile({ editor: true })).toBe(
    '// Generated by scripts/repo/setup/editor.mts.\n' +
      '{\n  "editor": true\n}\n',
  )
})
