* linguist-vendored
*.js linguist-vendored=false
bin/* -crlf -diff -merge
* eol=cr


# The compiler launcher is source, not a binary artifact.
bin/nwsapi text eol=lf diff merge
bin/*.mts text eol=lf diff merge linguist-vendored=false

# PyTorch checkpoints are committed model assets; keep their tensor payloads
# opaque in text diffs while leaving the adjacent JS and evidence reviewable.
assets/repo/pytorch/model/*.generated.pt binary linguist-generated
assets/repo/pytorch/model/*.generated.json -diff linguist-generated
assets/repo/pytorch/model/*.generated.mjs -diff linguist-generated
assets/repo/model-guide/narration/*.generated.mp3 binary linguist-generated
assets/repo/model-guide/fonts/*.woff2 binary
