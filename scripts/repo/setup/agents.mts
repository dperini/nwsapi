import {
  lstatSync,
  mkdirSync,
  readdirSync,
  readFileSync,
  writeFileSync,
} from 'node:fs'
import path from 'node:path'
import { parseArgs } from 'node:util'
import { REPO_ROOT } from '../lib/paths.mts'
import { isMainModule } from '../lib/run-node.mts'

const GENERATED = '<!-- Generated by scripts/repo/setup/agents.mts. -->'

type AgentOptions = {
  check?: boolean
  optional?: boolean
  help?: boolean
  json?: boolean
  describe?: boolean
  'dry-run'?: boolean
}

export function entry(file: string) {
  try {
    return lstatSync(file)
  } catch (error) {
    if ((error as NodeJS.ErrnoException).code === 'ENOENT') {
      return undefined
    }
    throw error
  }
}

export function safeParents(root: string, destination: string) {
  let directory = path.dirname(destination)
  while (directory !== root) {
    const stat = entry(directory)
    if (stat && (!stat.isDirectory() || stat.isSymbolicLink())) {
      throw new Error(
        `Preserved ${directory}: alias parent must be a real directory.`,
      )
    }
    directory = path.dirname(directory)
  }
}

export function writeAlias(
  root: string,
  relative: string,
  content: string,
  check: boolean,
) {
  const destination = path.join(root, relative)
  safeParents(root, destination)
  const stat = entry(destination)
  if (stat && (!stat.isFile() || stat.isSymbolicLink())) {
    throw new Error(
      `Preserved ${relative}: existing path is not a generated file.`,
    )
  }
  const previous = stat ? readFileSync(destination, 'utf8') : undefined
  if (previous === content) {
    return
  }
  if (previous !== undefined && !previous.includes(GENERATED)) {
    throw new Error(
      `Preserved ${relative}: contains custom instructions. Merge them manually before retrying.`,
    )
  }
  if (check) {
    throw new Error(
      `${relative} is missing or stale. Run pnpm run setup:agents.`,
    )
  }
  mkdirSync(path.dirname(destination), { recursive: true })
  writeFileSync(destination, content)
}

export function skillAliases(root: string) {
  const source = path.join(root, '.claude/skills')
  if (!entry(source)) {
    return []
  }
  return readdirSync(source, { withFileTypes: true })
    .filter(item => item.isDirectory())
    .toSorted((left, right) => left.name.localeCompare(right.name))
    .flatMap(item => {
      const skill = path.join(source, item.name, 'SKILL.md')
      if (!entry(skill)) {
        return []
      }
      const content = readFileSync(skill, 'utf8')
      const name = /^---\r?\n[\s\S]*?^name: ([a-z0-9-]+)\r?$/m.exec(
        content,
      )?.[1]
      if (name !== item.name) {
        throw new Error(`Skill name must match its directory: ${skill}`)
      }
      return [
        {
          relative: `.agents/skills/${item.name}/SKILL.md`,
          content: `${content.trimEnd()}\n\n${GENERATED}\n`,
        },
      ]
    })
}

export function setupAgentAliases(root = REPO_ROOT, check = false) {
  const aliases = agentAliases(root)
  const issues: string[] = []
  for (const alias of aliases) {
    try {
      writeAlias(root, alias.relative, alias.content, check)
    } catch (error) {
      issues.push(error instanceof Error ? error.message : String(error))
    }
  }
  return { count: aliases.length, issues }
}

export function agentAliases(root: string) {
  return [
    {
      relative: 'CLAUDE.md',
      content: `${GENERATED}\n\n@AGENTS.md\n`,
    },
    ...skillAliases(root),
  ]
}

export function agentAliasPlan(root = REPO_ROOT) {
  const changes = agentAliases(root).map(alias => {
    const destination = path.join(root, alias.relative)
    safeParents(root, destination)
    const stat = entry(destination)
    if (stat && (!stat.isFile() || stat.isSymbolicLink())) {
      throw new Error(
        `Preserved ${alias.relative}: existing path is not a generated file.`,
      )
    }
    const previous = stat ? readFileSync(destination, 'utf8') : undefined
    if (
      previous !== undefined &&
      previous !== alias.content &&
      !previous.includes(GENERATED)
    ) {
      throw new Error(
        `Preserved ${alias.relative}: contains custom instructions. Merge them manually before retrying.`,
      )
    }
    return {
      path: destination,
      operation:
        previous === alias.content
          ? 'unchanged'
          : previous === undefined
            ? 'create'
            : 'update',
    }
  })
  return {
    schemaVersion: 1,
    type: 'preview',
    command: 'setup/agents',
    root,
    changes,
  }
}

export function describeAgentSetup() {
  return {
    schemaVersion: 1,
    type: 'command',
    name: 'setup/agents',
    description:
      'Create ignored Claude and agent skill aliases from shared guidance.',
    options: ['--json', '--describe', '--dry-run', '--check', '--optional'],
    mutates: true,
  }
}

export function main(
  args = process.argv.slice(2),
  root = REPO_ROOT,
  log = console.log,
) {
  const { values } = parseArgs({
    args: args[0] === '--' ? args.slice(1) : args,
    options: {
      check: { type: 'boolean' },
      optional: { type: 'boolean' },
      help: { type: 'boolean', short: 'h' },
      json: { type: 'boolean' },
      describe: { type: 'boolean' },
      'dry-run': { type: 'boolean' },
    },
  })
  if (values.help) {
    log(
      'Usage: pnpm run setup:agents [--check] [--dry-run]\nCreates ignored Claude instructions and shared Codex/OpenCode skill aliases.\n--check reports missing or stale aliases without writing.\n--dry-run lists alias paths without writing.\n--optional reports conflicts without failing package preparation.',
    )
    return 0
  }
  const protocolResult = handleAgentProtocol(values, root, log)
  if (protocolResult !== undefined) {
    return protocolResult
  }
  const result = setupAgentAliases(root, values.check)
  for (const issue of result.issues) {
    console.error(issue)
  }
  if (result.issues.length > 0) {
    if (values.json) {
      log(
        JSON.stringify({
          schemaVersion: 1,
          type: 'result',
          status: 'failed',
          issues: result.issues,
        }),
      )
    }
    return values.optional && !values.check ? 0 : 1
  }
  log(
    values.json
      ? JSON.stringify({
          schemaVersion: 1,
          type: 'result',
          status: 'completed',
          count: result.count,
        })
      : `Agent guidance ready: ${result.count} local aliases. Shared source: AGENTS.md and .claude/skills/.`,
  )
  return 0
}

export function handleAgentProtocol(
  values: AgentOptions,
  root: string,
  log: (message: string) => void,
) {
  if (values.describe) {
    const description = describeAgentSetup()
    log(
      values.json
        ? JSON.stringify(description)
        : `${description.name}: ${description.description}\nUse --dry-run to list alias paths.`,
    )
    return 0
  }
  if (values['dry-run']) {
    if (values.check) {
      throw new Error('--check and --dry-run are mutually exclusive.')
    }
    const plan = agentAliasPlan(root)
    log(values.json ? JSON.stringify(plan) : formatAgentPlan(plan))
    return 0
  }
  return undefined
}

export function formatAgentPlan(plan: ReturnType<typeof agentAliasPlan>) {
  return [
    `Would prepare ${plan.command} in ${plan.root}:`,
    ...plan.changes.map(change => `  ${change.operation} ${change.path}`),
  ].join('\n')
}

if (isMainModule(import.meta.url)) {
  process.exitCode = main()
}
