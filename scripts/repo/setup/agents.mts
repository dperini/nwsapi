import {
  lstatSync,
  mkdirSync,
  readdirSync,
  readFileSync,
  writeFileSync,
} from 'node:fs'
import path from 'node:path'
import { parseArgs } from 'node:util'
import { REPO_ROOT } from '../lib/paths.mts'
import { isMainModule } from '../lib/run-node.mts'

const GENERATED = '<!-- Generated by scripts/repo/setup/agents.mts. -->'

function entry(file: string) {
  try {
    return lstatSync(file)
  } catch (error) {
    if ((error as NodeJS.ErrnoException).code === 'ENOENT') {
      return undefined
    }
    throw error
  }
}

function safeParents(root: string, destination: string) {
  let directory = path.dirname(destination)
  while (directory !== root) {
    const stat = entry(directory)
    if (stat && (!stat.isDirectory() || stat.isSymbolicLink())) {
      throw new Error(
        `Preserved ${directory}: alias parent must be a real directory.`,
      )
    }
    directory = path.dirname(directory)
  }
}

function writeAlias(
  root: string,
  relative: string,
  content: string,
  check: boolean,
) {
  const destination = path.join(root, relative)
  safeParents(root, destination)
  const stat = entry(destination)
  if (stat && (!stat.isFile() || stat.isSymbolicLink())) {
    throw new Error(
      `Preserved ${relative}: existing path is not a generated file.`,
    )
  }
  const previous = stat ? readFileSync(destination, 'utf8') : undefined
  if (previous === content) {
    return
  }
  if (previous !== undefined && !previous.includes(GENERATED)) {
    throw new Error(
      `Preserved ${relative}: contains custom instructions. Merge them manually before retrying.`,
    )
  }
  if (check) {
    throw new Error(
      `${relative} is missing or stale. Run pnpm run setup:agents.`,
    )
  }
  mkdirSync(path.dirname(destination), { recursive: true })
  writeFileSync(destination, content)
}

function skillAliases(root: string) {
  const source = path.join(root, '.claude/skills')
  if (!entry(source)) {
    return []
  }
  return readdirSync(source, { withFileTypes: true })
    .filter(item => item.isDirectory())
    .sort((left, right) => left.name.localeCompare(right.name))
    .flatMap(item => {
      const skill = path.join(source, item.name, 'SKILL.md')
      if (!entry(skill)) {
        return []
      }
      const content = readFileSync(skill, 'utf8')
      const name = /^---\r?\n[\s\S]*?^name: ([a-z0-9-]+)\r?$/m.exec(
        content,
      )?.[1]
      if (name !== item.name) {
        throw new Error(`Skill name must match its directory: ${skill}`)
      }
      return [
        {
          relative: `.agents/skills/${item.name}/SKILL.md`,
          content: `${content.trimEnd()}\n\n${GENERATED}\n`,
        },
      ]
    })
}

export function setupAgentAliases(root = REPO_ROOT, check = false) {
  const aliases = [
    {
      relative: 'CLAUDE.md',
      content: `${GENERATED}\n\n@AGENTS.md\n`,
    },
    ...skillAliases(root),
  ]
  const issues: string[] = []
  for (const alias of aliases) {
    try {
      writeAlias(root, alias.relative, alias.content, check)
    } catch (error) {
      issues.push(error instanceof Error ? error.message : String(error))
    }
  }
  return { count: aliases.length, issues }
}

export function main(args = process.argv.slice(2)) {
  const { values } = parseArgs({
    args: args[0] === '--' ? args.slice(1) : args,
    options: {
      check: { type: 'boolean' },
      optional: { type: 'boolean' },
      help: { type: 'boolean', short: 'h' },
    },
  })
  if (values.help) {
    console.log(
      'Usage: pnpm run setup:agents [--check]\nCreates ignored Claude instructions and shared Codex/OpenCode skill aliases.\n--check reports missing or stale aliases without writing.\n--optional reports conflicts without failing package preparation.',
    )
    return 0
  }
  const result = setupAgentAliases(REPO_ROOT, values.check)
  for (const issue of result.issues) {
    console.error(issue)
  }
  if (result.issues.length > 0) {
    return values.optional && !values.check ? 0 : 1
  }
  console.log(
    `Agent guidance ready: ${result.count} local aliases. Shared source: AGENTS.md and .claude/skills/.`,
  )
  return 0
}

if (isMainModule(import.meta.url)) {
  process.exitCode = main()
}
