import { mkdirSync, readFileSync, writeFileSync } from 'node:fs'
import path from 'node:path'
import { format } from 'oxfmt'
import type { FormatConfig } from 'oxfmt'
import formatterConfig from '../../../.config/oxfmt.json' with { type: 'json' }
import { REPO_ROOT } from '../lib/paths.mts'
import { isMainModule } from '../lib/run-node.mts'

const INPUT = path.join(
  REPO_ROOT,
  'assets/repo/bench/planner-2026-10-03/shared-model.json',
)
const OUTPUT = path.join(
  REPO_ROOT,
  'src/core/lookup/type-union-route-decision.generated.mts',
)

export async function renderTypeUnionRouteDecision(input = INPUT) {
  const model = JSON.parse(readFileSync(input, 'utf8')) as {
    guardedExpression: string
  }
  if (typeof model.guardedExpression !== 'string') {
    throw new Error('Type-union model is missing its guarded expression.')
  }
  return [
    '// Generated by scripts/repo/gen/type-union-route-decision.mts.',
    '// Experimental candidate only. Its evaluation did not pass promotion.',
    'export const typeUnionModelId = "planner-2026-10-03" as const',
    'export function chooseBroad(count: number, total: number, arity: number): boolean {',
    `  // oxlint-disable eslint/no-unneeded-ternary -- The fixed model expression preserves its exported candidate behavior.\n  return ${model.guardedExpression}`,
    '}',
    '',
  ].join('\n')
}

export async function writeTypeUnionRouteDecision(
  options: {
    check?: boolean
    input?: string
    output?: string
  } = {},
) {
  const { check = false, input = INPUT, output = OUTPUT } = options
  const source = await renderTypeUnionRouteDecision(input)
  const result = await format(output, source, formatterConfig as FormatConfig)
  if (result.errors.length) {
    throw new Error(result.errors.map(error => error.message).join('\n'))
  }
  const formatted = result.code
  if (check) {
    const current = readFileSync(output, 'utf8')
    if (current !== formatted) {
      throw new Error(
        `${path.relative(REPO_ROOT, output)} is stale; run gen:type-union-route-decision.`,
      )
    }
    return
  }
  mkdirSync(path.dirname(output), { recursive: true })
  writeFileSync(output, formatted)
}

if (isMainModule(import.meta.url)) {
  await writeTypeUnionRouteDecision({ check: process.argv.includes('--check') })
}
