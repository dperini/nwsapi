import { chmodSync, lstatSync, mkdirSync, readFileSync, writeFileSync } from "node:fs";
import path from "node:path";
import { parseArgs } from "node:util";
import { isMainModule, REPO_ROOT } from "../lib/paths.mts";

const GENERATED = "Generated by scripts/setup/editor.mts.";

export function editorFiles(platform: NodeJS.Platform, arch: string) {
  const useTsrs =
    (platform === "darwin" && arch === "arm64") ||
    (platform === "linux" && ["arm64", "x64"].includes(arch));
  const launcher = useTsrs
    ? `#!/bin/sh\nset -eu\nroot=$(CDPATH= cd "$(dirname "$0")/../../.." && pwd)\nexec "$root/node_modules/@maschwenk/tsrs/bin/tsrs" "$@"\n`
    : `#!/bin/sh\nset -eu\nroot=$(CDPATH= cd "$(dirname "$0")/../../.." && pwd)\nexec node "$root/node_modules/@typescript/native-preview/bin/tsgo" "$@"\n`;
  const vscodeSettings = {
    "js/ts.tsdk.path":
      platform === "win32" ? "node_modules/@typescript/native-preview" : ".cache/editor/tsdk",
    "js/ts.experimental.useTsgo": true,
  };
  const vscodeExtensions = {
    recommendations: ["TypeScriptTeam.native-preview"],
  };
  const zedSettings = {
    languages: Object.fromEntries(
      ["TypeScript", "TSX", "JavaScript", "JSX"].map((language) => [
        language,
        {
          language_servers: ["typescript-ls", "!vtsls", "!typescript-language-server", "..."],
        },
      ]),
    ),
    lsp: {
      "typescript-ls": {
        binary: {
          path: useTsrs
            ? ".cache/editor/tsdk/tsrs"
            : platform === "win32"
              ? `node_modules/@typescript/native-preview-${platform}-${arch}/lib/tsgo.exe`
              : ".cache/editor/tsdk/tsgo",
        },
      },
    },
  };
  return {
    engine: useTsrs ? "tsrs" : "tsgo",
    files: [
      { relative: ".vscode/settings.json", content: jsonFile(vscodeSettings) },
      {
        relative: ".vscode/extensions.json",
        content: jsonFile(vscodeExtensions),
      },
      { relative: ".zed/settings.json", content: jsonFile(zedSettings) },
    ],
    launchers: [
      ...(platform === "win32" ? [] : [{ relative: ".cache/editor/tsdk/tsgo", content: launcher }]),
      ...(useTsrs ? [{ relative: ".cache/editor/tsdk/tsrs", content: launcher }] : []),
    ],
  };
}

export function jsonFile(value: unknown) {
  return `// ${GENERATED}\n${JSON.stringify(value, null, 2)}\n`;
}

export function fileStat(file: string) {
  try {
    return lstatSync(file);
  } catch (error) {
    if ((error as NodeJS.ErrnoException).code === "ENOENT") {
      return undefined;
    }
    throw error;
  }
}

export function assertSafeParents(root: string, destination: string) {
  const checkout = path.resolve(root);
  const target = path.resolve(destination);
  const relative = path.relative(checkout, target);
  if (
    !relative ||
    relative === ".." ||
    relative.startsWith(`..${path.sep}`) ||
    path.isAbsolute(relative)
  ) {
    throw new Error(`Preserved ${destination}: editor path escapes the checkout.`);
  }
  let directory = path.dirname(target);
  while (directory !== checkout) {
    const stat = fileStat(directory);
    if (stat && (!stat.isDirectory() || stat.isSymbolicLink())) {
      throw new Error(`Preserved ${directory}: editor setup requires real directories.`);
    }
    directory = path.dirname(directory);
  }
}

export function writeGeneratedFile(
  root: string,
  relative: string,
  content: string,
  executable = false,
) {
  const file = path.join(root, relative);
  assertSafeParents(root, file);
  const stat = fileStat(file);
  if (stat) {
    if (!stat.isFile() || stat.isSymbolicLink()) {
      return "preserved";
    }
    if (readFileSync(file, "utf8") === content) {
      return "current";
    }
    return "preserved";
  }
  mkdirSync(path.dirname(file), { recursive: true });
  writeFileSync(file, content);
  if (executable) {
    chmodSync(file, 0o755);
  }
  return "written";
}

export function configureEditor(
  root = REPO_ROOT,
  platform = process.platform,
  arch = process.arch,
) {
  const plan = editorFiles(platform, arch);
  const results = [...plan.launchers, ...plan.files].map((file) => ({
    path: file.relative,
    status: writeGeneratedFile(
      root,
      file.relative,
      file.content,
      file.relative.startsWith(".cache/"),
    ),
  }));
  const preserved = results.filter((item) => item.status === "preserved");
  return {
    engine: plan.engine,
    results,
    messages: [
      plan.engine === "tsrs"
        ? "VS Code/Cursor: install the recommended TypeScript 7 extension and reload. Zed: install the TypeScript Language Server extension."
        : platform === "win32"
          ? "Windows uses the pinned TypeScript native preview compiler in VS Code/Cursor and Zed."
          : "This platform uses the pinned TypeScript native preview compiler.",
      ...(preserved.length
        ? [
            `Existing editor settings were preserved: ${preserved.map((item) => item.path).join(", ")}. Merge the generated settings manually if needed.`,
          ]
        : []),
    ],
  };
}

export function describeEditorSetup() {
  return {
    schemaVersion: 1,
    type: "command",
    name: "setup/editor",
    description:
      "Configure workspace TypeScript editor settings for pinned tsrs or TypeScript native preview.",
    options: ["--json", "--describe", "--dry-run"],
    mutates: true,
  };
}

export function editorSetupPlan(
  root = REPO_ROOT,
  platform = process.platform,
  arch = process.arch,
) {
  const plan = editorFiles(platform, arch);
  return {
    schemaVersion: 1,
    type: "preview",
    command: "setup/editor",
    engine: plan.engine,
    targets: [...plan.launchers, ...plan.files].map((file) => path.join(root, file.relative)),
    messages: ["Install the recommended editor language-server extension."],
  };
}

export function formatEditorSetupPlan(plan: ReturnType<typeof editorSetupPlan>) {
  return [
    `Would configure the ${plan.engine} editor language service:`,
    ...plan.targets.map((target) => `  ${target}`),
    ...plan.messages.map((message) => `  ${message}`),
  ].join("\n");
}

export async function main(args = process.argv.slice(2)) {
  const { values } = parseArgs({
    args: args[0] === "--" ? args.slice(1) : args,
    options: {
      help: { type: "boolean", short: "h" },
      json: { type: "boolean" },
      describe: { type: "boolean" },
      "dry-run": { type: "boolean" },
    },
  });
  if (values.help) {
    console.log("Usage: npm run setup:editor [--dry-run]");
  } else if (values.describe) {
    const description = describeEditorSetup();
    console.log(values.json ? JSON.stringify(description) : description.description);
  } else if (values["dry-run"]) {
    const plan = editorSetupPlan();
    console.log(values.json ? JSON.stringify(plan) : formatEditorSetupPlan(plan));
  } else {
    const result = configureEditor();
    console.log(values.json ? JSON.stringify(result) : result.messages.join("\n"));
  }
}

if (isMainModule(import.meta.url)) {
  await main();
}
