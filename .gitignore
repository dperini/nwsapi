# Ignore everything by default; opt maintained files in explicitly.
# See https://packagemain.tech/p/gitignore-everything-by-default
*
!*/

# Root metadata.
!/.gitattributes
!/.gitignore
!/.gitmodules
!/.npmrc
!/AGENTS.md
!/LICENSE
!/README.md
!/THANKS.md
!/package.json
!/tak.toml
!/pnpm-lock.yaml
!/pnpm-workspace.yaml
!/vitest.config.mts

# Maintained file types, scoped to their source trees.
!/.config/**/*.json
!/.config/**/*.md
!/.config/**/*.mts
!/.config/model-training/**/*.toml
!/.config/model-training/**/uv.lock
!/.config/perf-video/Cargo.toml
!/.config/perf-video/Cargo.lock
!/.config/perf-video/*.rs
!/.config/security/**/*.toml
!/.config/security/**/uv.lock
!/.config/**/*.ts
!/.github/**/*.Dockerfile
!/.github/**/*.yml
!/.github/**/*.yaml
!/.github/**/*.mts
!/assets/**/*.LICENSE
!/assets/**/*.json
!/assets/**/*.svg
!/assets/repo/bench/compilation-report.html
!/assets/repo/bench/planner-neural-2026-10-04/model.mjs
!/assets/repo/bench/survey-2026-10-03/neural-planner.html
!/assets/repo/bench/survey-2026-10-03/tiny-model-training.html
!/assets/repo/pytorch/model/*.generated.mjs
!/assets/repo/pytorch/model/*.generated.pt
!/assets/repo/pytorch/model/*-weights.generated.json
!/assets/repo/pytorch/model/model.txt
!/assets/repo/model-guide/narration/*.generated.mp3
!/assets/repo/model-guide/fonts/*.woff2
!/assets/repo/model-guide/fonts/*-license.txt
!/bin/nwsapi
!/bin/*.mts
!/docs/**/*.md
!/docs/repo/perf/pytorch-has-routing.html
!/docs/repo/perf/pytorch-has-routing.css
!/docs/repo/perf/pytorch-has-routing.mts
!/docs/repo/perf/pytorch-has-routing/*.mts
!/docs/repo/perf/pytorch-has-routing/*.css
!/scripts/**/*.mts
!/scripts/**/*.py
!/src/**/*.mts
!/src/**/*.d.ts
!/test/**/*.LICENSE
!/test/**/*.bat
!/test/slick/Configuration.js.complete
!/test/**/*.conf
!/test/**/*.css
!/test/**/*.gif
!/test/**/*.headers
!/test/**/*.html
!/test/**/*.ico
!/test/**/*.jar
!/test/**/*.js
!/test/**/*.json
!/test/**/*.md
!/test/slick/Configuration.js.modular
!/test/**/*.mts
!/test/**/*.py
!/test/w3c/resources/testharness.js.orig
!/test/**/*.php
!/test/**/*.png
!/test/**/*.sh
!/test/**/*.svg
!/test/**/*.txt
!/test/**/*.xht
!/test/**/*.xhtml
!/test/**/*.xml
!/test/slick/Runner/Jasmine-Node/LICENSE
!/test/slick/Runner/reports/README
!/test/slick/Runner/server
!/test/slick/Runner/test
!/test/w3c/resources/LICENSE

# Generated output and vendored dependencies override file-type opt-ins.
**/node_modules/
/.cache/
/.vitiate/
/.tmp/
/.pnpm-store/
/coverage/
/dist/
/playwright-report/
/test-results/
/upstream/
/src/**/*.js
!/src/external/*.js
!/src/external/*.d.ts
yarn.lock
