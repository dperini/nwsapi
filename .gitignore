# Ignore everything by default; opt maintained files in explicitly.
# See https://packagemain.tech/p/gitignore-everything-by-default
*
!*/

# Root metadata.
!/.gitattributes
!/.gitignore
!/.gitmodules
!/.npmrc
!/AGENTS.md
!/LICENSE
!/README.md
!/THANKS.md
!/package.json
!/pnpm-lock.yaml
!/pnpm-workspace.yaml
!/vitest.config.mts

# Maintained file types, scoped to their source trees.
!/.config/**/*.json
!/.config/**/*.md
!/.config/**/*.mts
!/.config/**/*.ts
!/.github/**/*.Dockerfile
!/.github/**/*.yml
!/assets/**/*.LICENSE
!/assets/**/*.json
!/assets/**/*.svg
!/bin/nwsapi
!/bin/*.mts
!/docs/**/*.md
!/scripts/**/*.mts
!/src/**/*.mts
!/test/**/*.LICENSE
!/test/**/*.bat
!/test/slick/Configuration.js.complete
!/test/**/*.conf
!/test/**/*.css
!/test/**/*.gif
!/test/**/*.headers
!/test/**/*.html
!/test/**/*.ico
!/test/**/*.jar
!/test/**/*.js
!/test/**/*.json
!/test/**/*.md
!/test/slick/Configuration.js.modular
!/test/**/*.mts
!/test/w3c/resources/testharness.js.orig
!/test/**/*.php
!/test/**/*.png
!/test/**/*.sh
!/test/**/*.svg
!/test/**/*.txt
!/test/**/*.xht
!/test/**/*.xhtml
!/test/**/*.xml
!/test/slick/Runner/Jasmine-Node/LICENSE
!/test/slick/Runner/reports/README
!/test/slick/Runner/server
!/test/slick/Runner/test
!/test/w3c/resources/LICENSE

# Generated output and vendored dependencies override file-type opt-ins.
**/node_modules/
/.cache/
/.vitiate/
/.tmp/
/.pnpm-store/
/coverage/
/dist/
/playwright-report/
/test-results/
/upstream/
/src/**/*.js
!/src/external/*.js
!/src/external/*.d.ts
yarn.lock
