{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Contributor tools",
  "type": "object",
  "additionalProperties": false,
  "required": ["tools"],
  "properties": {
    "$schema": { "type": "string" },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "npm", "pnpm"],
      "properties": {
        "node": { "$ref": "#/$defs/tool" },
        "npm": { "$ref": "#/$defs/tool" },
        "pnpm": { "$ref": "#/$defs/tool" }
      }
    }
  },
  "$defs": {
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "version"],
      "properties": {
        "origin": { "const": "system" },
        "version": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){0,2}$" }
      }
    }
  }
}
