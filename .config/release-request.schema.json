{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["version", "distTag"],
  "properties": {
    "version": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "string",
          "pattern": "^3\\.\\d+\\.\\d+-prerelease(?:\\.\\d+)*$"
        }
      ]
    },
    "distTag": { "type": "string", "const": "next" }
  },
  "additionalProperties": false,
  "title": "Staged v3 release request"
}
