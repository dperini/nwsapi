{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2024", "DOM"],
    "types": ["node", "vitest"],
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "../.cache/tsconfig.check.tsbuildinfo",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "resolveJsonModule": true
  },
  "include": [
    "../src/**/*.mts",
    "../scripts/repo/**/*.mts",
    "../test/repo/**/*.mts",
    "./*.mts",
    "./*.d.ts"
  ]
}
